# This is a single-user, local-only prototype. Do not bind it to a public interface.
HOST=127.0.0.1
PORT=5000
# Per client IP, per 60-second window.
API_RATE_LIMIT=120
ANALYZE_RATE_LIMIT=30
REPAIR_RATE_LIMIT=8
RUN_RATE_LIMIT=10
# Optional AI repair. Keep this key server-side; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If configured but unavailable, /api/health/ready returns 503 while
# /api/health/live stays healthy and MongoDB retries every 30 seconds.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=codesentinel
