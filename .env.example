# Backend target used by the local Vite development proxy.
CODE_SENTINEL_BACKEND_URL=http://127.0.0.1:5000

# Local mode is loopback-only. Public mode is opt-in and startup-gated; see README.
HOST=127.0.0.1
PORT=5000
PUBLIC_DEPLOYMENT=false
API_RATE_LIMIT=120
ANALYZE_RATE_LIMIT=30
REPAIR_RATE_LIMIT=30
MENTOR_RATE_LIMIT=15
RUN_RATE_LIMIT=10
RUN_TIMEOUT_MS=10000
REVIEW_RETENTION_DAYS=30
# Optional AI repair and Learning Hub mentor. Keep this key server-side; never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public mode only: configure these only after completing the README operator checklist.
# PUBLIC_DEPLOYMENT=true
# NODE_ENV=production
# PUBLIC_APP_URL=https://app.example.com
# CLIENT_ORIGINS=https://app.example.com
# TRUST_PROXY=1
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=KLYRO <accounts@example.com>
# MONGODB_BACKUP_RETENTION_DAYS=30
# MONGODB_BACKUP_RESTORE_TESTED_AT=2026-10-01T12:00:00Z

# MongoDB enables account registration/sign-in and private server-side review history.
# Without it, guest analysis works and review history stays in browser storage.
# URL-encode special characters in credentials if the URI contains them.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=codesentinel
